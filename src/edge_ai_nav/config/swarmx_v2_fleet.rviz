Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MAP1
        - /ROBOTS1
        - /LIDAR1
        - /ROUTES1
      Splitter Ratio: 0.5
    Tree Height: 780
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Binary representation: false
          Binary threshold: 100
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: Shared warehouse map
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 2
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map
          Update Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map_updates
          Use Timestamp: false
          Value: true
      Enabled: true
      Name: MAP
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: ALPHA 1-5 names
          Namespaces:
            Value: true
            stage2_robot_names: true
          Topic:
            Depth: 2
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /fleet/spawn_labels
          Value: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1.3
          Name: ALPHA 1 pose
          Radius: 0.09
          Reference Frame: alpha_1/base_footprint
          Value: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1.3
          Name: ALPHA 2 pose
          Radius: 0.09
          Reference Frame: alpha_2/base_footprint
          Value: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1.3
          Name: ALPHA 3 pose
          Radius: 0.09
          Reference Frame: alpha_3/base_footprint
          Value: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1.3
          Name: ALPHA 4 pose
          Radius: 0.09
          Reference Frame: alpha_4/base_footprint
          Value: true
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1.3
          Name: ALPHA 5 pose
          Radius: 0.09
          Reference Frame: alpha_5/base_footprint
          Value: true
      Enabled: true
      Name: ROBOTS
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 255; 55; 70
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ALPHA 1 LiDAR
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.08
          Style: Flat Squares
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 2
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /alpha_1/scan
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 55; 135; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ALPHA 2 LiDAR
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.08
          Style: Flat Squares
          Topic: {Depth: 1, Durability Policy: Volatile, Filter size: 2, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /alpha_2/scan}
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 30; 255; 70
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ALPHA 3 LiDAR
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 8
          Size (m): 0.08
          Style: Flat Squares
          Topic: {Depth: 1, Durability Policy: Volatile, Filter size: 2, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /alpha_3/scan}
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 255; 145; 35
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ALPHA 4 LiDAR
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.08
          Style: Flat Squares
          Topic: {Depth: 1, Durability Policy: Volatile, Filter size: 2, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /alpha_4/scan}
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 190; 70; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ALPHA 5 LiDAR
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.08
          Style: Flat Squares
          Topic: {Depth: 1, Durability Policy: Volatile, Filter size: 2, History Policy: Keep Last, Reliability Policy: Best Effort, Value: /alpha_5/scan}
          Use Fixed Frame: true
          Value: true
      Enabled: true
      Name: LIDAR
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 55; 70
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.08
          Name: ALPHA 1 route
          Offset: {X: 0, Y: 0, Z: 0.08}
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: {Depth: 1, Durability Policy: Transient Local, Filter size: 2, History Policy: Keep Last, Reliability Policy: Reliable, Value: /alpha_1/route_path}
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 55; 135; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.08
          Name: ALPHA 2 route
          Offset: {X: 0, Y: 0, Z: 0.09}
          Pose Style: None
          Topic: {Depth: 1, Durability Policy: Transient Local, Filter size: 2, History Policy: Keep Last, Reliability Policy: Reliable, Value: /alpha_2/route_path}
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 55; 240; 95
          Enabled: true
          Line Style: Lines
          Line Width: 0.08
          Name: ALPHA 3 route
          Offset: {X: 0, Y: 0, Z: 0.10}
          Pose Style: None
          Topic: {Depth: 1, Durability Policy: Transient Local, Filter size: 2, History Policy: Keep Last, Reliability Policy: Reliable, Value: /alpha_3/route_path}
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 145; 35
          Enabled: true
          Line Style: Lines
          Line Width: 0.08
          Name: ALPHA 4 route
          Offset: {X: 0, Y: 0, Z: 0.11}
          Pose Style: None
          Topic: {Depth: 1, Durability Policy: Transient Local, Filter size: 2, History Policy: Keep Last, Reliability Policy: Reliable, Value: /alpha_4/route_path}
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 190; 70; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.08
          Name: ALPHA 5 route
          Offset: {X: 0, Y: 0, Z: 0.12}
          Pose Style: None
          Topic: {Depth: 1, Durability Policy: Transient Local, Filter size: 2, History Policy: Keep Last, Reliability Policy: Reliable, Value: /alpha_5/route_path}
          Value: true
      Enabled: true
      Name: ROUTES
      Value: true
  Enabled: true
  Global Options:
    Background Color: 26; 31; 38
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Entire warehouse
      Near Clip Distance: 0.01
      Scale: 22
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
      X: 25
      Y: 20
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 20
  Y: 20
